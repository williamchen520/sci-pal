  "deployment": {
    "compose_file": "deploy/docker-compose.yml",
    "services": [
      "app",
      "watch-cron",
      "caddy"
    ],
    "caddy_ports": [
      80,
      443
    ],
    "data_root": "G:\\sciPal_deploy",
    "image": "scipal-app:latest",
    "models_mount": "/models:ro",
    "offline_bundle": "deploy/build_offline_bundle.py"
  },
  "tests": {
    "framework": "unittest",
    "count": 698,
    "duration_seconds": 60,
    "command": "venv_sciPal_py312\\Scripts\\python.exe -m unittest discover -s tests -p \"test_*.py\"",
    "coverage": [
      "检索",
      "路由",
      "guard",
      "JATS 导入",
      "watch",
      "domain packs",
      "claim",
      "多用户隔离",
      "项目/实验"
    ]
  },
  "limitations": [
    "XML 论文无 bbox；MinerU 兜底路径也无 bbox",
    "未被正文提及的图表/参考文献没有位置",
    "Europe PMC 503 时无法继续扩量",
    "PDF 章节树来自解析推断，XML 才是原生结构",
    "多用户已实现，但仍是 SQLite 单节点",
    "Claim 试点仅覆盖 10 个 HCC claim",
    "writing_brief 仅 1 个 claim 完成",
    "在线 ingest 仅完成 2 篇；PMC13036683 下载失败",
    "写作闸门仍为 brief + 人工检查，未自动拒绝违规句",
    "云端生成会把论文文本发送到外部 provider",
    "DSH 插件化仍未实现 MCP evidence / validate 工具",
    "ARCHITECTURE.json 为人工维护的快照，以 docs/架构与路由图.md 为准"
  ],
  "docs": {
    "architecture": "docs/架构与路由图.md",
    "readme": "README.md",
    "claim": "docs/claim-pilot-审讯记录-01.md",
    "claim_online_ingest": "docs/claim-pilot-在线入库-01.md",
    "domain_pack": "packs/biomed-oncoimmuno/README.md",
    "tests": "docs/评测说明.md"
  },
  "collaboration": {
    "highest_priority_rules": ".dsh_rules",
    "details": "docs/协作规范.md",
    "pr_template": ".github/pull_request_template.md",
    "violation_token": "RULE_VIOLATION"
  },
  "quality_guards": {
    "stop_loss": {
      "module": "services/quality/stop_loss.py",
      "test_runner": "scripts/run_tests_guarded.py",
      "metric_recorder": "scripts/record_eval_metric.py",
      "state_file": "logs/stop_loss_state.json",
      "limit": 2,
      "message": "触发止损规则，停止调参，等待人类介入"
    }
  },
  "plugins": {
    "status": "M0/M1/M2",
    "paths": {
      "contracts": "services/plugins/contracts.py",
      "registry": "services/plugins/registry.py",
      "runner": "services/plugins/runner.py",
      "manifests": "plugins/manifests/",
      "ports": "plugins/ports/",
      "adapters": "plugins/adapters/",
      "bench": "eval/plugin_bench.py",
      "run_log": "logs/plugin_runs.jsonl"
    },
    "trust_model": "trusted in-process adapters; subprocess/container isolation later",
    "smoke_plugin": "echo",
    "claim_verifier": {
      "port": "plugins/ports/claim_verifier.json",
      "adapters": [
        "claim-verifier-nli",
        "claim-verifier-rule",
        "claim-verifier-underdetermines"
      ],
      "bench": "eval/claim_verifier_bench.py",
      "dataset": "eval/plugins/claims_pilot_cases.json",
      "first_result": {
        "rule_accuracy": 0.3636,
        "underdetermines_accuracy": 0.0,
        "majority_baseline": 0.9091,
        "note": "pipeline only; dataset imbalanced (10 supports / 1 mentions)"
      },
      "balanced_dataset": {
        "path": "eval/plugins/claims_pilot_balanced_cases.json",
        "builder": "scripts/build_claim_balanced_cases.py",
        "cases": 30,
        "labels": {
          "supports": 10,
          "refutes": 10,
          "underdetermines": 10
        },
        "results": {
          "rule_accuracy": 0.4333,
          "underdetermines_accuracy": 0.3333,
          "majority_baseline": 0.3333
        },
        "caveat": "refutes are derived_opposite_claim; human review required before publication"
      }
    },
    "retriever": {
      "port": "plugins/ports/retriever.json",
      "adapters": [
        "retriever-bm25",
        "retriever-dense",
        "retriever-hybrid",
        "retriever-hybrid-rerank"
      ],
      "bench": "eval/retriever_bench.py",
      "dataset": "eval/plugins/retriever_queries.json",
      "cases": 74,
      "corpus": 100,
      "results": {
        "bm25": {
          "recall@10": 0.9459,
          "mrr": 0.8149,
          "ndcg@10": 0.8476
        },
        "dense": {
          "recall@10": 0.9324,
          "mrr": 0.8829,
          "ndcg@10": 0.8954
        },
        "hybrid": {
          "recall@10": 0.9459,
          "mrr": 0.9036,
          "ndcg@10": 0.9142
        },
        "hybrid_rerank": {
          "recall@10": 0.9865,
          "mrr": 0.9081,
          "ndcg@10": 0.928
        }
      },
      "caveat": "74 queries, 20 cross-topic, 48 distractors; not publication-grade",
      "sources": {
        "seed_100": 14,
        "cross_topic": 20,
        "claim_qualifiers": 20,
        "paper_title": 20
      }
    }
  },
  "benchmark_db": {
    "policy": "postgresql-required-for-large-or-concurrent",
