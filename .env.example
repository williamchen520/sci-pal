# Sci-Pal Environment Configuration
# Copy this file to .env and fill in your values.
# 主路径读取 SCIPAL_* 前缀（services/review/llm_client.py、services/qa/qa_service.py）。
# 注意：config/settings.py 仍保留旧 AI_* 前缀作为兼容默认，功能以 SCIPAL_* 为准。

# ── Server config ──────────────────────────────────────────────
HOST=0.0.0.0
PORT=5000
DEBUG=False

# ── Retrieval ──────────────────────────────────────────────────
# Optional near-duplicate suppression; unset = disabled.
# SCIPAL_NEAR_DUP_THRESHOLD=0.90

# ── Database ───────────────────────────────────────────────────
DATABASE_PATH=data/research.db
UPLOAD_FOLDER=data/uploads

# ════════════════════════════════════════════════════════════════
# LLM 配置（二选一：本地 Ollama 为推荐默认；或 OpenAI 兼容云端）
# ════════════════════════════════════════════════════════════════

# ── 路线 A：本地 Ollama（V33.9 推荐，8GB 显存）──────────────────
# 取消下面四行的注释，并把 SCIPAL_LLM_PROVIDER 设为 ollama
SCIPAL_LLM_PROVIDER=ollama
SCIPAL_LLM_HOST=http://localhost:11434
# 重量模型：写综述、问答（必须 Q4 量化，FP16 在 8GB 会爆显存）
SCIPAL_LLM_MODEL=qwen2.5:7b-instruct-q4_K_M
# 轻量模型：大纲、证据抽取、引用验证
SCIPAL_LLM_LIGHT_MODEL=qwen2.5:3b

# ── 路线 B：OpenAI 兼容云端（DeepSeek / 通义 DashScope / OpenAI）─
# 切到本路线时，把 SCIPAL_LLM_PROVIDER 改为 openai，并取消下面注释
# SCIPAL_LLM_PROVIDER=openai
# SCIPAL_LLM_BASE_URL=https://api.deepseek.com/v1
# SCIPAL_LLM_API_KEY=sk-your-api-key-here
# SCIPAL_LLM_MODEL=deepseek-chat
# DashScope 示例：
# SCIPAL_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# SCIPAL_LLM_MODEL=qwen-plus
# SCIPAL_LLM_LIGHT_MODEL=qwen-turbo

# ── LLM 可选调参 ────────────────────────────────────────────────
SCIPAL_LLM_TIMEOUT=1800
SCIPAL_LLM_MAX_RETRIES=1
SCIPAL_LLM_TEMPERATURE=0.3

# ════════════════════════════════════════════════════════════════
# 在线检索（可选）
# ════════════════════════════════════════════════════════════════
# Protocols.io 实时方法检索：在 https://www.protocols.io/developers 取 Token
SCIPAL_PROTOCOLS_IO_TOKEN=
# 设为 false 可关闭 Protocols.io
SCIPAL_PROTOCOLS_IO_ENABLED=true

# 说明：NCBI PubMed/PMC 当前由 online_search.py 内置默认凭证，暂未读取
# NCBI_API_KEY / NCBI_EMAIL 环境变量，无需在此配置；内置密钥请勿提交进仓库。

# ── 兼容遗留（config/settings.py，可留空）──────────────────────
AI_API_KEY=
AI_MODEL=qwen-plus
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_MAX_RETRIES=2
AI_COVERAGE_THRESHOLD=0.9
