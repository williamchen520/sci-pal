#!/bin/sh
# Early guard for ARCHITECTURE.json changes.
#
# Git's pre-commit hook cannot see the current commit message (it runs before
# the message file exists). The message-tag enforcement is therefore in
# .githooks/commit-msg. This hook validates the staged JSON and warns loudly.

staged=$(git diff --cached --name-only --diff-filter=ACMRD -- ARCHITECTURE.json)
[ -z "$staged" ] && exit 0

echo "pre-commit: ARCHITECTURE.json is staged." >&2
echo "pre-commit: commit-msg will require [APPROVED_BY_HUMAN]." >&2

if command -v python >/dev/null 2>&1; then
    git show :ARCHITECTURE.json | python -c "import json,sys; json.load(sys.stdin)" || {
        echo "pre-commit: staged ARCHITECTURE.json is not valid JSON; refusing commit." >&2
        exit 1
    }
fi

exit 0
