{
  "id": "echo",
  "version": "0.1.0",
  "description": "M0 smoke-test port: returns the input text and its length.",
  "input_schema": {
    "type": "object",
    "required": ["text"],
    "properties": {
      "text": {"type": "string"}
    },
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "required": ["echo", "length"],
    "properties": {
      "echo": {"type": "string"},
      "length": {"type": "integer", "minimum": 0}
    },
    "additionalProperties": false
  }
}
