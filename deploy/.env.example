# Copy to deploy/.env and fill in.
# NEVER commit deploy/.env.

SCIPAL_SECRET_KEY=replace-with-a-long-random-string

# LLM provider for public/published evidence only.
# For private evidence, configure an on-prem or approved HPC endpoint here.
SCIPAL_LLM_PROVIDER=openai
SCIPAL_LLM_BASE_URL=https://api.deepseek.com/v1
SCIPAL_LLM_MODEL=deepseek-chat
SCIPAL_LLM_API_KEY=replace-me

# Local retrieval / parsing
# always: use paragraphs_contextual for all queries (2026-11-03 production)
# adaptive: contextual only for complex questions
SCIPAL_CONTEXTUAL_MODE=always
SCIPAL_GROBID_URL=http://127.0.0.1:8070
SCIPAL_GROBID_URL_FULL=http://127.0.0.1:8071
MINERU_HOME=/opt/mineru

# Backups (backup-cron service)
SCIPAL_BACKUP_INTERVAL_HOURS=24
SCIPAL_BACKUP_DB_RETENTION_DAYS=30
SCIPAL_BACKUP_FULL_RETENTION_DAYS=28
SCIPAL_BACKUP_FULL_INTERVAL_DAYS=7

# PostgreSQL (P4/P5)
# SCIPAL_PG_DSN=postgresql://scipal:replace-me@host.docker.internal:5433/scipal_bench
SCIPAL_PG_POOL_MIN=1
SCIPAL_PG_POOL_MAX=10
SCIPAL_PG_POOL_TIMEOUT=5
# FTS backend: sqlite (default) or postgres (term3 candidates + rerank)
SCIPAL_FTS_BACKEND=sqlite
SCIPAL_PG_FTS_CANDIDATES=50
SCIPAL_PG_FTS_TERM_LIMIT=3
# Query expansion variants (1-4); lower is faster but may reduce recall
SCIPAL_MULTI_QUERY=1
SCIPAL_MAX_QUERY_VARIANTS=4
SCIPAL_WARMUP=0
SCIPAL_RERANK=1
SCIPAL_RERANK_MAX_ITEMS=20
SCIPAL_RERANK_MAX_CHARS=400

# Auth and tenancy
SCIPAL_AUTH_REQUIRED=1
SCIPAL_DATA_CLASS=public
SCIPAL_EMBEDDING_MODEL=/models/models/BAAI--bge-base-en-v1.5
SCIPAL_RERANK_MODEL=/models/models/BAAI--bge-reranker-base

# Optional: bootstrap one local admin on first start.
# SCIPAL_ADMIN_USERNAME=admin
# SCIPAL_ADMIN_PASSWORD=replace-me
