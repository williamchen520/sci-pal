# Sci-Pal Environment Configuration
# Copy this file to .env and fill in your values

# Server config
HOST=0.0.0.0
PORT=5000
DEBUG=False

# Database
DATABASE_PATH=data/research.db
UPLOAD_FOLDER=data/uploads

# AI / LLM Configuration
# Use DashScope (Qwen) by default - same as your etymology project
AI_API_KEY=sk-your-api-key-here
AI_MODEL=qwen-plus
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Alternative: OpenAI
# AI_API_KEY=sk-your-openai-key
# AI_MODEL=gpt-4o-mini
# AI_BASE_URL=https://api.openai.com/v1

# Alternative: Local Ollama (V33.9 推荐: 7b Q4量化版, 8GB显存可跑)
# SCIPAL_LLM_PROVIDER=ollama
# SCIPAL_LLM_HOST=http://localhost:11434
# SCIPAL_LLM_MODEL=qwen2.5:7b-instruct-q4_K_M
# SCIPAL_LLM_LIGHT_MODEL=qwen2.5:3b

# AI Settings
AI_MAX_RETRIES=2
AI_COVERAGE_THRESHOLD=0.9
